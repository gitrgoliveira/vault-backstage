# Copy to .env for local development
HCP_TF_TOKEN=replace-with-hcp-terraform-team-token
HCP_TF_ORGANIZATION=replace-with-your-org-name
HCP_TF_BASE_URL=https://app.terraform.io

# Optional: GitLab SSO (only needed when enabling auth.providers.gitlab)
# AUTH_GITLAB_CLIENT_ID=
# AUTH_GITLAB_CLIENT_SECRET=
# AUTH_GITLAB_BASE_URL=https://gitlab.com
